# Copy the current UAT backend.env to the VM as /opt/ys/config/instance-51.env.
# Keep this template in Git only; never commit the real VM environment file.

# Compose interpolation and release locations
YS_VUE_DIR=/opt/ys/current-vue
YS_BACKEND_ENV_FILE=/opt/ys/config/instance-51.env
YS_WEB_BIND_ADDRESS=0.0.0.0
YS_WEB_HOST_PORT=80
YS_GCP_DATA_DIR=/srv/ys/gcp/data
YS_GCP_UPLOADS_DIR=/srv/ys/gcp/uploads
YS_GCP_PGDATA_DIR=/srv/ys/gcp/pgdata
YS_GCP_REDISDATA_DIR=/srv/ys/gcp/redisdata
YS_GCP_BACKUPS_DIR=/srv/ys/gcp/backups

# The following application settings are required in the real, untracked file.
# Copy the currently working UAT values, then review environment-specific values.
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ys_uat
POSTGRES_USER=ys_uat
POSTGRES_PASSWORD=replace-with-a-strong-password
REDIS_HOST=redis
REDIS_PORT=6379
DATA_DIR=/data
UPLOAD_STORAGE_PATH=/app/py/S3
YS_CERP_MODE=fake
SECRET_KEY=replace-with-a-long-random-secret
YS_ADMIN_USERNAME=ys-admin
YS_ADMIN_PASSWORD=replace-with-a-strong-password
YS_SUPER_ADMIN_USERNAME=ys-super-admin
YS_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=admin@ys.local
EMAIL_ENABLED=false
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_FALLBACK_CHAT_MODEL=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
PGVECTOR_DIM=384
RAG_MIN_SCORE=0.40

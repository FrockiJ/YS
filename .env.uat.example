# Copy to F:\Projects\ys\config\uat\backend.env and replace local values.
APP_HOST=0.0.0.0
APP_PORT=8000
YS_ENV_FILE=/run/config/backend.env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ys_uat
POSTGRES_USER=ys_uat
POSTGRES_PASSWORD=replace-with-a-local-password
REDIS_HOST=redis
REDIS_PORT=6379
DATA_DIR=/data
UPLOAD_STORAGE_PATH=/app/py/S3
YS_CERP_MODE=fake
SECRET_KEY=replace-with-a-long-local-secret
YS_ADMIN_USERNAME=ys-admin
YS_ADMIN_PASSWORD=replace-with-a-local-password
YS_SUPER_ADMIN_USERNAME=ys-super-admin
YS_SUPER_ADMIN_PASSWORD=replace-with-a-local-password
ADMIN_EMAIL=admin@ys.local
EMAIL_ENABLED=false
OPENAI_API_KEY=
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
PGVECTOR_DIM=384
RAG_MIN_SCORE=0.40
